          "name": "11 - Registrar cita a las 10",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/citas",
            "description": "Respuesta esperada: **201**. Cambia mascotaId y veterinarioId por los ids recibidos. Usa una fecha futura en hora de Colombia, con segundos en cero. Guarda el cuerpo para la prueba de cruce.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUsuario}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaHora\": \"2030-10-20T10:00:00\",\n  \"motivo\": \"Control general\",\n  \"mascotaId\": 1,\n  \"veterinarioId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
